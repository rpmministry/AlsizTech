# =========================================================
# AlsizTech — Configuración de Producción Apache (.htaccess)
# =========================================================

# 1. Juego de caracteres por defecto UTF-8
AddDefaultCharset UTF-8

# 2. Seguridad: Ocultar archivos confidenciales
<FilesMatch "^(\.env|\.git|\.cpanel\.yml|package\.json|server\.js|leads\.json)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Compresión Gzip (Mod_Deflate) para carga ultra rápida
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 4. Políticas de Caché del Navegador
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Redirección limpia
DirectoryIndex index.html
