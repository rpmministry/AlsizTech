# =========================================================
# CONFIGURACIÓN DE DESPLIEGUE A PRODUCCIÓN - ALSIZTECH
# =========================================================
# Si utiliza un Hosting cPanel / Hostinger / GoDaddy / FTP:
# Copie este archivo como '.env' y complete con sus datos:
#
# FTP_HOST=ftp.alsiztech.com (o IP de su servidor)
# FTP_USER=su_usuario_cpanel
# FTP_PASSWORD=su_contraseña
# FTP_PORT=21
# FTP_SECURE=false (o true si su hosting requiere FTPS explícito)
# FTP_REMOTE_DIR=/public_html/
#
# =========================================================
# Si utiliza Vercel:
# No requiere FTP. Simplemente ejecute: npm run deploy:vercel
# =========================================================
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=false
FTP_REMOTE_DIR=/public_html/
